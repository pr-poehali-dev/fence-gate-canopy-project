{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/?action=deals",
      "expectedStatus": 200
    },
    {
      "name": "Unauthorized без токена",
      "method": "GET",
      "path": "/?action=deals",
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Unauthorized stats",
      "method": "GET",
      "path": "/?action=stats",
      "expectedStatus": 401
    },
    {
      "name": "Unknown action возвращает 401 без авторизации",
      "method": "GET",
      "path": "/?action=blah",
      "expectedStatus": 401
    }
  ]
}
