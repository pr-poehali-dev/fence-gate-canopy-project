{
  "tests": [
    {
      "name": "Get prices list",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Unauthorized POST upsert is rejected",
      "method": "POST",
      "path": "/",
      "headers": {"Content-Type": "application/json"},
      "body": {"action": "upsert", "slug": "test_unauth", "title": "x", "price": 1, "unit": "руб", "category": "other"},
      "expectedStatus": 401
    },
    {
      "name": "Unauthorized DELETE is rejected",
      "method": "DELETE",
      "path": "/?id=99999",
      "expectedStatus": 401
    },
    {
      "name": "Get calc pricing list",
      "method": "GET",
      "path": "/?action=calc",
      "expectedStatus": 200
    },
    {
      "name": "Calc pricing PUT requires auth",
      "method": "PUT",
      "path": "/?action=calc",
      "headers": {"Content-Type": "application/json"},
      "body": {"items": []},
      "expectedStatus": 401
    }
  ]
}